# Port du serveur de production (défaut: 4173)
PORT=4173

# Interface d'écoute (défaut: 127.0.0.1 — utiliser 0.0.0.0 uniquement derrière un reverse proxy de confiance)
# HOST=127.0.0.1

# Signature Android release (npm run aab:release)
# KEYSTORE_PATH=./release.keystore
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=

# Active les en-têtes de sécurité production en local (CSP stricte, HSTS)
# MANHAW_PROD_SECURITY=1

# Environnement Node (production active HSTS)
# NODE_ENV=production

# Tests uniquement — désactive les sources live
# SKIP_LIVE_SOURCES=1

# Monitoring Sentry (frontend uniquement, optionnel)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# VITE_APP_VERSION=1.2.0
