{
  "name": "manga-shelf-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "prebuild": "node scripts/generate-pwa-icons.mjs",
    "prebuild:android": "node scripts/generate-pwa-icons.mjs && node scripts/generate-android-icons.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0",
    "start:prod": "node server/productionServer.js",
    "electron:start": "electron .",
    "electron:dev": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win",
    "build:win:portable": "npm run build && electron-builder --win portable",
    "test:electron": "node scripts/electron-smoke-test.mjs",
    "test": "node --test server/tests/*.test.js src/tests/*.test.js",
    "audit:deps": "npm audit --audit-level=moderate",
    "build:android": "npm run prebuild:android && vite build && npx cap sync android && node scripts/patch-android-chromebook.mjs",
    "apk:debug": "npm run build:android && node scripts/assemble-android-apk.mjs",
    "apk:docker": "bash scripts/android-docker-build.sh",
    "android": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:docker:up": "docker compose -f docker/android-emulator/docker-compose.yml up -d",
    "android:docker:build": "bash scripts/android-docker-build.sh",
    "android:docker:install": "bash scripts/android-docker-install.sh"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-background-task": "^8.1.7",
    "fdir": "^6.5.0",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.468.0",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0",
    "react": "^18.3.1",
    "react-aria-components": "^1.20.0",
    "react-dom": "^18.3.1",
    "react-snowfall": "^2.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.1.5",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.4",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.manhaw.cinevault",
    "productName": "CineVault",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/main.js",
      "electron/preload.cjs",
      "public/pwa/icon-512.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/pwa/icon-512.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CineVault",
      "artifactName": "setup-${version}.exe",
      "include": "installer.nsh"
    },
    "portable": {
      "artifactName": "CineVault-Portable-${version}.exe"
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
